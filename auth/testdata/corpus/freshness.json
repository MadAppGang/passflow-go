    {"id": "now-fractional-age-300-999", "now": 1700000600.999, "auth_time": 1700000300, "max_age": 300, "allow": true, "header_if_rejected": "Bearer error=\"insufficient_user_authentication\", max_age=300", "note": "whole seconds: the age is 300"},
