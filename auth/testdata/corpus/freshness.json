    {"id": "auth-time-exactly-2-pow-53", "now": 1700000600, "auth_time": 9007199254740992, "max_age": 300, "allow": true, "header_if_rejected": "Bearer error=\"insufficient_user_authentication\", max_age=300", "note": "the largest value read as a date: in the future, so not stale"},
    {"id": "auth-time-above-2-pow-53", "now": 1700000600, "auth_time": 9007199254740994, "max_age": 300, "allow": false, "header_if_rejected": "Bearer error=\"insufficient_user_authentication\", max_age=300", "note": "read as absent; read as a date it would be in the future and allowed"},
