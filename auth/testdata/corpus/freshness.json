    {"id": "auth-time-fractional-truncated-rejected", "now": 1700000601, "auth_time": 1700000300.9, "max_age": 300, "allow": false, "header_if_rejected": "Bearer error=\"insufficient_user_authentication\", max_age=300", "note": "truncated toward zero: age 301; rounding up would allow it"},
