{
  "corpus_version": 2,
  "description": "cases pins the freshness decision: reject when now - auth_time > max_age in whole seconds, no leeway on auth_time, a fractional now and a fractional auth_time truncated, an auth_time beyond 2^53 in magnitude read as absent. It binds the two libraries, and not the server. max_age_input pins what the freshness constructors accept: truncate toward zero to whole seconds, then require at least 1. effective is both the enforced and the emitted value.",
  "cases": [
    {"id": "age-equals-max-age", "now": 1700000600, "auth_time": 1700000300, "max_age": 300, "allow": true, "header_if_rejected": "Bearer error=\"insufficient_user_authentication\", max_age=300"},
    {"id": "age-one-over-max-age", "now": 1700000601, "auth_time": 1700000300, "max_age": 300, "allow": false, "header_if_rejected": "Bearer error=\"insufficient_user_authentication\", max_age=300"},
